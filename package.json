{
  "name": "route-planner",
  "version": "1.0.0",
  "description": "Личный планер маршрутов — будущее Telegram Mini App. Фронт (Vite, vanilla ESM) + бэкенд фазы 1 (Express + SQLite).",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "vite": "^5.4.0"
  }
}
