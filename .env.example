# Скопируй в .env и заполни. .env в git не коммитится.

# Ключ Anthropic для генерации маршрутов (Этап 1). Без него работает MOCK.
ANTHROPIC_API_KEY=
# Модель генерации (по умолчанию claude-sonnet-4-6).
LLM_MODEL=claude-sonnet-4-6

# Токен Telegram-бота из BotFather (Этап 5). Без него сервер в DEV-режиме (без проверки подписи).
BOT_TOKEN=
# Белый список Telegram user id (через запятую) — доступ к API только этим людям.
# Пусто = пускаем любого с валидной подписью. Защищает платный AI от чужих запросов.
ALLOWED_USER_IDS=
# Ключ RapidAPI (AeroDataBox) для автозаполнения рейса по номеру. Пусто = только ручной ввод.
FLIGHT_API_KEY=
# FLIGHT_API_HOST=aerodatabox.p.rapidapi.com

# Импорт мест из скриншота Google Maps. По умолчанию — Claude-зрение (тот же
# ANTHROPIC_API_KEY, ~0,4¢/скрин). Чтобы использовать бесплатный OCR.space:
# IMPORT_OCR_ENGINE=ocrspace
# OCR_SPACE_KEY=

# База данных:
#   - если задан DATABASE_URL → Postgres (прод на Railway задаёт его сам);
#   - иначе → локальный SQLite-файл по DB_PATH.
# Для локального теста против Railway-Postgres вставь сюда DATABASE_PUBLIC_URL из Railway:
# DATABASE_URL=

# Прочее (необязательно).
# PORT=3000
# DB_PATH=./data/planner.sqlite
