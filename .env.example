# Скопируй в .env и заполни. .env в git не коммитится.

# Ключ Anthropic для генерации маршрутов (Этап 1). Без него работает MOCK.
ANTHROPIC_API_KEY=
# Модель генерации (по умолчанию claude-sonnet-4-6).
LLM_MODEL=claude-sonnet-4-6

# Токен Telegram-бота из BotFather (Этап 5). Без него сервер в DEV-режиме (без проверки подписи).
BOT_TOKEN=

# База данных:
#   - если задан DATABASE_URL → Postgres (прод на Railway задаёт его сам);
#   - иначе → локальный SQLite-файл по DB_PATH.
# Для локального теста против Railway-Postgres вставь сюда DATABASE_PUBLIC_URL из Railway:
# DATABASE_URL=

# Прочее (необязательно).
# PORT=3000
# DB_PATH=./data/planner.sqlite
